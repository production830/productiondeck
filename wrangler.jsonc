{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "productiondeck",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://jqjbyekctjhvrfltidfc.supabase.co"
  },
  "build": {
    "command": "node scripts/vendor-pdf.mjs"
  }
}
