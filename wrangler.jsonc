{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "productiondeck",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://jqjbyekctjhvrfltidfc.supabase.co"
  },
  "build": {
    "command": "node scripts/vendor-pdf.mjs && node scripts/vendor-vision.mjs"
  },
  "ratelimits": [
    {
      "name": "CASTING_IP_LIMIT",
      "namespace_id": "830101",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "CASTING_GLOBAL_LIMIT",
      "namespace_id": "830102",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "ACCOUNT_SETUP_LIMIT",
      "namespace_id": "830103",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
